  `sott` int(11) NOT NULL DEFAULT '0',
  `masp` varchar(14) NOT NULL,
  `mahm` char(14) NOT NULL,
  `tenhm` varchar(300) NOT NULL,
  `mavt` char(14) NOT NULL,
  `dvt` varchar(100) NOT NULL,
