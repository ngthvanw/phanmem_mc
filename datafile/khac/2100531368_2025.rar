  `cpkhongduoctru` int(1) NOT NULL,
  `theodoi` int(1) NOT NULL DEFAULT '1',
  PRIMARY KEY (`sott`),
  UNIQUE KEY `mats` (`mats`)
) ENGINE=InnoDB AUTO_INCREMENT=51 DEFAULT CHARSET=utf8;

