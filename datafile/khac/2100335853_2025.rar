  `tygia` bigint(20) NOT NULL,
  `sotiennt` double(15,3) NOT NULL,
  PRIMARY KEY (`sott`),
  KEY `index_matkcha` (`matkcha`),
  KEY `index_matk` (`matk`)
) ENGINE=InnoDB AUTO_INCREMENT=301 DEFAULT CHARSET=utf8;

