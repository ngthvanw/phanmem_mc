INSERT INTO masp VALUES('173511245147','CT2024','Thi công công trình 2024','0','','','Thi cong cong trinh 2024','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','12','0'),('173511249258','CT2024-001','2024_Nhà cầu nối cho lối đi. Theo HĐ số 078/2024/HĐXD ngày 07/08/2024 với Bệnh viện Đa khoa tỉnh Trà Vinh','CT2024','','','2024_Nha cau noi cho loi di. Theo HD so 078/2024/HDXD ngay 07/08/2024 voi Benh vien Da khoa tinh Tra Vinh','','Phường 7, TP.Trà Vinh, Tỉnh Trà Vinh','0000-00-00','970000000','2024-08-15','2024-10-14','0','0','0','0','CT','1','2024','13','DBKK'),('173535117163','CT2024-002','2024_Sửa chữa Bệnh viện Lao và Bệnh phổi. Theo HĐ số 128/2024/HĐXD/NM-PGKTM ngày 12/08/2024','CT2024','','','2024_Sua chua Benh vien Lao va Benh phoi. Theo HD so 128/2024/HDXD/NM-PGKTM ngay 12/08/2024','','Ấp Sâm Bua, xã Lương Hòa, huyện Châu Thành, Tỉnh Trà Vinh','0000-00-00','341016971','2024-08-19','2024-12-16','0','0','0','0','CT','1','2024','14','DBDBKK'),('173535184920','CT2024-003','2024_Thi công Lắp cửa kính hành lang khu khám A tại Bệnh viện Đa khoa tỉnh Trà Vinh. Theo QĐ số 2420/QĐ-BVĐK ngày 22/10/2024','CT2024','','','2024_Thi cong Lap cua kinh hanh lang khu kham A tai Benh vien Da khoa tinh Tra Vinh. Theo QD so 2420/QD-BVDK ngay 22/10/2024','','Phường 7, TP.Trà Vinh, Tỉnh Trà Vinh','0000-00-00','26100800','2024-10-22','2024-10-29','0','0','0','0','CT','1','2024','15','DBKK'),('93176846130650','CT2025-004','2025_TVGS lắp đặt thiết bị văn phòng DA Đầu tư XDCT lĩnh vực Quân sự thuộc Bộ CHQS tỉnh Trà Vinh số 02/2025/HĐKT-PGKTM (ký ngày 10/1/2025)','CT2025','','','2025_TVGS lap dat thiet bi van phong DA Dau tu XDCT linh vuc Quan su thuoc Bo CHQS tinh Tra Vinh so 02/2025/HDKT-PGKTM (ky ngay 10/1/2025)','','Huyện Duyên Hải, Tỉnh Trà Vinh.','0000-00-00','35299000','2025-01-10','0001-01-01','0','0','0','0','CT','1','','22','DBKK'),('93176846151269','CT2025-005','2025_Cung cấp xà gồ , tôn lợp mái thuộc công trình cải tạo, sữa chữa bệnh viện đa kh