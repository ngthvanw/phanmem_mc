DROP TABLE IF EXISTS danhsach_hopdong_daily;

CREATE TABLE `danhsach_hopdong_daily` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `namhd` int(4) NOT NULL,
  `ngaybd` date NOT NULL,
  `ngaykt` date NOT NULL,
  `giadichvu` double NOT NULL,
  `teptin` text NOT NULL,
  `nguoinhap` char(1) NOT NULL,
  `ngaynhap` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `ngaythaydoi` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `ghichu` text NOT NULL,
  PRIMARY KEY (`sott`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

