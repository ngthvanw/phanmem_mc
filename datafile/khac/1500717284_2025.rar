DROP TABLE IF EXISTS manhomkh;

CREATE TABLE `manhomkh` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `manhom` int(11) NOT NULL,
  `tennhom` varchar(500) NOT NULL,
