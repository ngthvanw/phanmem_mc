  KEY `mand` (`mand`),
  KEY `tennoidung` (`tennoidung`),
  KEY `tenkd` (`tenkd`),
  FULLTEXT KEY `fmtm` (`mand`,`tenkd`)
) ENGINE=InnoDB AUTO_INCREMENT=598 DEFAULT CHARSET=utf8;

