  `rate` char(2) DEFAULT NULL,
  `chietkhau` int(2) NOT NULL,
  `sl` int(1) NOT NULL,
  `makho` char(4) DEFAULT NULL,
  `kho` varchar(60) DEFAULT NULL,
  `tenkd` char(200) NOT NULL,
