INSERT INTO masp VALUES('1','0001','Toàn Bộ','0','Cái','','HANG SAN XUAT','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','','','2024','1',''),('25165088112882','BPSX','BỘ PHẬN SẢN XUẤT','0','','','BO PHAN SAN XUAT','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','5','0'),('25165088114299','BPSX-001','Bộ phận sản xuất','BPSX','','','Bo phan san xuat','','','0000-00-00','1405034825','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','6','DBKK'),('25165899985957','CCVT','CUNG CẤP VẬT TƯ','0','','','CUNG CAP VAT TU','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','7','0'),('25165899987464','CCVT-001','Hợp đồng số 41A/HĐKT.2022 ,Cung cấp vật tư và nhân công trang trí gian hàng Công ty tại Hội chợ triển lãm thương mại Sản Phẩm công nghiệp nông thôn - OCOP, Trà Vinh năm 2022 tại Trung tâm văn hóa tỉnh Trà Vinh','CCVT','','','Hop dong so 41A/HDKT.2022 ,Cung cap vat tu va nhan cong trang tri gian hang Cong ty tai Hoi cho trien lam thuong mai San Pham cong nghiep nong thon - OCOP, Tra Vinh nam 2022 tai Trung tam van hoa tinh Tra Vinh','','','0000-00-00','38955556','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','8','DBKUD'),('111168653279086','CCVT-002','&#039#*#&#039#*#Ốp alu gương cột khu trưng bày Cửa hàng Honda Trà Vinh&#039#*#&#039#*# theo HĐ số 24A/HĐKT ngày 21.3.2023','CCVT','','','&#039#*#&#039#*#Op alu guong cot khu trung bay Cua hang Honda Tra Vinh&#039#*#&#039#*# theo HD so 24A/HDKT ngay 21.3.2023','','','0000-00-00','27224250','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','9','DBKUD'),('111168653386459','BPSX-002','&#039#*#&#039#*#Gia công lắp dựng khung thép hộp Cửa hàng Honda Trà Vinh&#039#*#&#039#*# theo HĐ số 19A/HĐKT ngày 03.3.2023','BPSX','','','&#039#*#&#039#*#Gia cong lap dung khung thep hop Cua hang Honda Tra Vinh&#039#*#&#039#*# theo HD so 19A/HDKT ngay 03.3.2023','','','0000-00-00','8860600','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','10','DBKUD'),('111168654245983','BPSX-003','&#039#*#&#039#*#Ốp alu gương cột khu khách chờ Cửa hàng Honda Trà Vinh&#039#*#&#039#*#theo HĐ số 34 HĐKT ngày 04 tháng 5 năm 2023','BPSX','','','&#039#*#&#039#*#Op alu guong cot khu khach cho Cua hang Honda Tra Vinh&#039#*#&#039#*#theo HD so 34 HDKT ngay 04 thang 5 nam 2023','','','0000-00-00','22601500','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','11','DBKUD'),('111168895534917','BPSX-004','&#039#*#&#039#*#Ốp alu sau quầy thu ngân khu bán hàng Cửa hàng Honda Trà Cú&#039#*#&#039#*# theo hợp đồng Số 38/HĐKT ngày 18.5.2023','BPSX','','','&#039#*#&#039#*#Op alu sau quay thu ngan khu ban hang Cua hang Honda Tra Cu&#039#*#&#039#*# theo hop dong So 38/HDKT ngay 18.5.2023','','','0000-00-00','16547500','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','12','DBKK'),('111169744664245','BPSX-005','Thi công dán decal mặt ngoài, cắt chữ mi ca Cửa hàng xe máy tại thị xã Duyên Hải theo hợp đồng Số : 55/HĐKT ngày 10 tháng 7 năm 2023','BPSX','','','Thi cong dan decal mat ngoai, cat chu mi ca Cua hang xe may tai thi xa Duyen Hai theo hop dong So : 55/HDKT ngay 10 thang 7 nam 2023','','','0000-00-00','9791400','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','13','DBKK'),('111169744735049','BPSX-006','Thay tấm poly lấy sáng mái thông tầng (giếng trời) theo hợp đồng &#039#*#&#039#*# Số : 64/HĐKT .2023, ngày 17 / 8 /2023&#039#*#&#039#*#','BPSX','','','Thay tam poly lay sang mai thong tang (gieng troi) theo hop dong &#039#*#&#039#*# So : 64/HDKT .2023, ngay 17 / 8 /2023&#039#*#&#039#*#','','','0000-00-00','27310185','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','14','DBKK'),('111176103902491','SC','SỬA CHỮA','0','','','SUA CHUA','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','15','0'),('111176103902873','SC-001','Sửa chữa biển nhận diện thương hiệu cho Chi nhánh, Phòng giao dịch thuộc Agribank Chi nhánh Trà Vinh theo hợp đồng số 207/HĐKT/TL-2025 ngày 02/7/2025','SC','','','