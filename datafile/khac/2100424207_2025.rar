-007','','Thay block máy lạnh','','2403273-01','','TV','','0','0','0','0','0','0','0000-00-00','','Thay block may lanh','1','VND','1001','','','3568'),('111177449194739','2505516','2100645446','CÔNG TY TNHH THƯƠNG MẠI XÂY DỰNG THÀNH VINH TV','','0','','Thửa đất số 493, tờ bản đồ số 38, ấp Sâm Bua, Xã Song Lộc, Tỉnh Vĩnh Long, Việt Nam','','0','0','0','0','0','0','0000-00-00','','CONG TY TNHH THUONG MAI XAY DUNG THANH VINH TV','1','VND','1001','','','5616'),('111177449195471','2505516-01','','Tư vấn Gói thầu 01 Khảo sát đo vẽ hiện trạng và Gói thầu 02 Lập báo cáo kinh tế kỹ thuật đầu tư xây dựng công trình Nâng cấp Trung tâm văn hóa huyện ( theo hợp đồng số: 47/2024/HĐ-TVTK ngày 05/12/2024 ). Bản vẽ thiết kế kỹ thuật hạng mục Phòng cháy chữa cháy, chiếm 22,4% giá trị hợp đồng.','','2505516','','.','','0','0','0','0','0','0','0000-00-00','','Tu van Goi thau 01 Khao sat do ve hien trang va Goi thau 02 Lap bao cao kinh te ky thuat dau tu xay dung cong trinh Nang cap Trung tam van hoa huyen ( theo hop dong so: 47/2024/HD-TVTK ngay 05/12/2024 ). Ban ve thiet ke ky thuat hang muc Phong chay chua chay, chiem 22,4% gia tri hop dong.','1','VND','1001','','','5617'),('111177449240013','2505618','2100396165','CÔNG TY TNHH MỘT THÀNH VIÊN HÀ TÂM','','0','','Số 232, Lê Lợi, Phường Trà Vinh, Tỉnh Vĩnh Long, Việt Nam','','0','0','0','0','0','0','0000-00-00','','CONG TY TNHH MOT THANH VIEN HA TAM','1','VND','1001','','','5618'),('111177449242551','2505618-01','','2025_CT:Thi công hệ thống chiếu sáng đường giao thông và HTTN thuộc Phường 5, 7, 8 Thành Phố Trà Vinh','','2505618','','.','','0','0','0','0','0','0','0000-00-00','','2025_CT:Thi cong he thong chieu sang duong giao thong va HTTN thuoc Phuong 5, 7, 8 Thanh Pho Tra Vinh','1','VND','1001','','','5619'),('111177449257044','2505620','2100599207','BỘ CHỈ HUY QUÂN SỰ TỈNH TRÀ VINH','','0','','Võ Nguyên Giáp, Khóm 10, Phường Nguyệt Hóa, Tỉnh Vĩnh Long, Việt Nam','','0','0','0','0','0','0','0000-00-00','','BO CHI HUY QUAN SU TINH TRA VINH','1','VND','1001','','','5620'),('111177449259142','2505620-01','','2025_CT:Gia công giá súng, giá đồng bộ, tủ súng bộ binh Năm 2025. Theo hợp đồng 05/HĐTC, ngày 24/04/2025.','','2505620','','.','','0','0','0','0','0','0','0000-00-00','','2025_CT:Gia cong gia sung, gia dong bo, tu sung bo binh Nam 2025. Theo hop dong 05/HDTC, ngay 24/04/2025.','1','VND','1001','','','5621'),('111177449269362','2505622','2100690505','CÔNG TY TNHH YU YUAN VN','','0','','Thửa đất số 355, tờ bản đồ số 8, đường tỉnh lộ 914, Ấp La Ba, Xã Đôn Châu, Tỉnh Vĩnh Long, Việt Nam','','0','0','0','0','0','0','0000-00-00','','CONG TY TNHH YU YUAN VN','1','VND','1001','','','5622'),('111177449270982','2505622-01','','2025_CT:Đo kiểm hệ thống chống sét ( điện trở tiếp đất, thông mạch )','','2505622','','.','','0','0','0','0','0','0','0000-00-00','','2025_CT:Do kiem he thong chong set ( dien tro tiep dat, thong mach )','1','VND','1001','','','5623'),('111177449277419','2505624','2100696546','PHÒNG KINH TẾ, HẠ TẦNG VÀ ĐÔ THỊ THÀNH PHỐ TRÀ VINH','','0','','Số 09 Lê Thánh Tôn, Phường Trà Vinh, Tỉnh Vĩnh Long, Việt Nam','','0','0','0','0','0','0','0000-00-00','','PHONG KINH TE, HA TANG VA DO THI THANH PHO TRA VINH','1','VND','1001','','','5624'),('111177449279144','2505624-01','','Tư vấn Lập báo cáo kinh tế kỹ thuật công trình Sửa chữa đèn chiếu sáng công cộng đường phố, hẻm trên địa bàn thành phố Trà Vinh. Theo hợp đồng số 01/2025/HĐ.TVTK ngày 11/03/2025.','','2505624','','.','','0','0','0','0','0','0','0000-00-00','','Tu van Lap bao cao kinh te ky thuat cong trinh Sua chua den chieu sang cong cong duong pho, hem tren dia ban thanh pho Tra Vinh. Theo hop dong so 01/2025/HD.TVTK ngay 11/03/2025.','1','VND','1001','','','5625'),('111177449288334','2505624-02','','Thanh toán chi phí tư vấn khảo sát và lập hồ sơ Báo cáo kinh tế - kỹ thuật công trình: Sửa chữa, thay mới dây nguồn điện chiếu sáng công cộng các tuyến đường trên địa bàn thành phố Trà Vinh ( theo hợp đồng số : 02/2025/HĐ.TVTK ký ngày 11 tháng 3 năm 2025)','','2505624','','.','','0','0','0','0','0','0','0000-00-00','','Thanh toan chi phi tu van khao sat va lap ho so Bao cao kinh te - ky thuat cong trinh: Sua chua, thay moi day nguon dien chieu sang cong cong cac tuyen duong tren dia ban thanh pho Tra Vinh ( theo hop dong so : 02/2025/HD.TVTK ky ngay 11 thang 3 nam 2025)','1','VND','1001','','','5626');
ALTER TABLE makh AUTO_INCREMENT=5657;
DROP TABLE IF EXISTS makho;

CREATE TABLE `makho` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `makho` char(4) NOT NULL,
  `tenkho` varchar(100) DEFAULT NULL,
  `diachi` varchar(40) DEFAULT NULL,
  `ghichu` text,
  `tenkhokd` varchar(100) NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `makho` (`makho`),
  KEY `tenkhokd` (`tenkhokd`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8;

INSERT INTO makho VALUES('1','0010','Kho chung','','','kho');
DROP TABLE IF EXISTS maloaiduong;

CREATE TABLE `maloaiduong` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `maduong` int(4) NOT NULL,
  `tenduong` varchar(400) NOT NULL,
  `ghichu` text NOT NULL,
  `pptinh` int(1) NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `maduong` (`maduong`)
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8;

INSERT INTO maloaiduong VALUES('1','1001','Quốc lộ','','1'),('2','1002','Tỉnh lộ','','1'),('3','1003','Hương lộ','','1'),('4','1004','Đường Đal','','1'),('5','1005','Định mức theo kilomet đường','','2');
DROP TABLE IF EXISTS mand;

CREATE TABLE `mand` (
  `sott` int(6) NOT NULL AUTO_INCREMENT,
  `mand` char(6) NOT NULL,
  `tennoidung` varchar(1000) DEFAULT NULL,
  `rate_tax` char(2) DEFAULT NULL,
  `tkno` varchar(6) DEFAULT NULL,
  `tkco` varchar(6) DEFAULT NULL,
  `ghichu` text,
  `mapl` varchar(4) DEFAULT NULL,
  `tenkd` varchar(100) NOT NULL,
  `rank` int(10) DEFAULT NULL,
  `tennoidung_en` varchar(250) NOT NULL,
  `tennoidung_cn` varchar(250) NOT NULL,
  PRIMARY KEY (`sott`),
  KEY `mand` (`mand`),
  KEY `tennoidung` (`tennoidung`(255)),
  KEY `tenkd` (`tenkd`),
  FULLTEXT KEY `fmtm` (`mand`,`tenkd`)
) ENGINE=InnoDB AUTO_INCREMENT=486 DEFAULT CHARSET=utf8;

