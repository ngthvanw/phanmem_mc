CREATE TABLE `manhanvien` (
  `sott` int(10) unsigned NOT NULL,
  `manhanvien` int(6) NOT NULL AUTO_INCREMENT,
  `tennv` varchar(100) NOT NULL,
  `socmnd` char(12) NOT NULL,
