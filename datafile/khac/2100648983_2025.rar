  `tenkd` varchar(200) NOT NULL,
  `manhomts` varchar(6) NOT NULL,
  `tennhomts` varchar(255) NOT NULL,
  `mapsts` int(11) NOT NULL,
  `thamchieu` bigint(14) NOT NULL,
  `loaisp` varchar(2) NOT NULL,
