CREATE TABLE `matk` (
  `sott` int(10) unsigned NOT NULL,
  `matk` char(6) NOT NULL,
  `tentk` varchar(255) DEFAULT NULL,
  `matkcha` char(4) NOT NULL,
  `loaitk` varchar(60) DEFAULT NULL,
