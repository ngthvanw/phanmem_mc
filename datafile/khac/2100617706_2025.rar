  UNIQUE KEY `umavt` (`mavt`),
  UNIQUE KEY `stt` (`stt`),
  KEY `sott` (`sott`),
  KEY `mavt` (`mavt`),
  KEY `index_tenvt` (`tenvt`(255)),
  KEY `sapxep` (`sapxep`),
  KEY `id_mavttt` (`mavttt`),
  FULLTEXT KEY `tenkd` (`tenkd`),
