CREATE TABLE `mats` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `mats` char(14) NOT NULL,
  `tents` varchar(300) DEFAULT NULL,
  `dvt` varchar(100) NOT NULL,
  `matk` char(6) NOT NULL,
  `ngaysd` date DEFAULT NULL,
  `nuocsx` varchar(100) DEFAULT NULL,
