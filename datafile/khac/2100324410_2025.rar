CREATE TABLE `sdtkdk` (
  `sott` int(10) NOT NULL AUTO_INCREMENT,
  `matk` varchar(14) NOT NULL,
  `tentk` varchar(200) NOT NULL,
  `soduno` bigint(20) NOT NULL,
