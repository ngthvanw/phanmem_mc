  KEY `makh` (`makh`),
  FULLTEXT KEY `fmakh` (`makh`),
  FULLTEXT KEY `masothue` (`masothue`),
  FULLTEXT KEY `fmtm` (`makh`,`tenkd`,`masothue`),
