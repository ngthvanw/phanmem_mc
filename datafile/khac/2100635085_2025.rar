  `_cock` bigint(20) NOT NULL,
  `matkcha` varchar(6) NOT NULL,
  PRIMARY KEY (`sott`)
) ENGINE=InnoDB AUTO_INCREMENT=41 DEFAULT CHARSET=utf8;

