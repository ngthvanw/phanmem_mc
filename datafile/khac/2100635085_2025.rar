  `ngaykhoicong` date NOT NULL,
  `ngayhoanthanh` date NOT NULL,
  `vatlieu` bigint(20) NOT NULL,
  `nhancong` bigint(20) NOT NULL,
  `may` bigint(20) NOT NULL,
