  `kt` double(7,2) DEFAULT NULL,
  `sldk` double(12,3) DEFAULT NULL,
  `gtvndk` bigint(13) DEFAULT NULL,
  `slntk` double(13,3) DEFAULT NULL,
  `gtnvnd` bigint(14) DEFAULT NULL,
