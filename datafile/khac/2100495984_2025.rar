  `phantramnam` float NOT NULL,
  `tinhluong` char(2) NOT NULL,
  `phucapchucvu` bigint(20) NOT NULL,
  `phicongdoan` bigint(20) NOT NULL,
  `baohiem` bigint(20) NOT NULL,
  `baohiemyt` bigint(20) NOT NULL,
