CREATE TABLE `bangcdtk` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `tentk` varchar(200) NOT NULL,
  `matk` varchar(14) NOT NULL,
  `nodk` bigint(20) NOT NULL,
  `codk` bigint(20) NOT NULL,
  `nops` bigint(20) NOT NULL,
