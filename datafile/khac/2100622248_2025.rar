  KEY `sott` (`sott`),
  KEY `tenct` (`tenct`(191)),
  KEY `mact` (`mact`),
  KEY `mactcha` (`mactcha`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4;

