DROP TABLE IF EXISTS mand;

CREATE TABLE `mand` (
  `sott` int(6) NOT NULL AUTO_INCREMENT,
  `mand` char(6) NOT NULL,
  `tennoidung` varchar(1000) DEFAULT NULL,
  `rate_tax` char(2) DEFAULT NULL,
  `tkno` varchar(6) DEFAULT NULL,
  `tkco` varchar(6) DEFAULT NULL,
