DROP TABLE IF EXISTS maloaiduong;

CREATE TABLE `maloaiduong` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `maduong` int(4) NOT NULL,
  `tenduong` varchar(400) NOT NULL,
