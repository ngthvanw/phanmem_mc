  `btps` int(11) NOT NULL,
  `tongcongnt` double NOT NULL,
  `lacanhan` int(1) NOT NULL,
  `tencanhan` varchar(200) NOT NULL,
  `machinhanh` char(14) NOT NULL,
  PRIMARY KEY (`sott`),
