  `thietminh` varchar(10) NOT NULL,
  `phanloai` int(1) NOT NULL,
  PRIMARY KEY (`sott`)
) ENGINE=InnoDB AUTO_INCREMENT=46 DEFAULT CHARSET=utf8;

