INSERT INTO plthuetndnuudai VALUES("1","1.1","Doanh nghiệp sản xuất mới thành lập từ dự án đầu tư.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("2","1.2","Doanh nghiệp di chuyển địa điểm ra khỏi đô thị theo quy hoạch đã được cơ quan có thẩm quyền phê duyệt.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("3","1.3","Doanh nghiệp mới thành lập từ dự án đầu tư vào ngành nghề, lĩnh vực ưu đãi đầu tư.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("4","1.4","Doanh nghiệp mới thành lập từ dự án đầu tư vào ngành nghề, lĩnh vực đặc biệt ưu đãi đầu tư.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("5","1.5","Doanh nghiệp mới thành lập từ dự án đầu tư vào nghành nghề, lĩnh vực ưu đãi đầu tư theo quy định tại Nghị định số 124/2008/NĐ-CP.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("6","1.6","Doanh nghiệp mới thành lập từ dự án đầu tư vào địa bàn thuộc Danh mục địa bàn có điều kiện kinh tế - xã hội khó khăn.","1","0","0","","","1");
INSERT INTO plthuetndnuudai VALUES("7","1.7","Doanh nghiệp mới thành lập từ dự án đầu tư vào địa bàn thuộc Danh mục địa bàn có điều kiện kinh tế - xã hội đặc biệt khó khăn, khu kinh tế, khu công nghệ cao.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("8","1.8","Doanh nghiệp thành lập mới trong lĩnh vực xã hội hoá hoặc có thu nhập từ hoạt động xã hội hoá.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("9","1.9","Hợp tác xã dịch vụ nông nghiệp, Quỹ tín dụng nhân dân.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("10","1.10","Ưu đãi theo Giấy phép đầu tư, Giấy chứng nhận ưu đãi đầu tư.","1","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("11","3","Xác định số thuế TNDN chênh lệch do doanh nghiệp hưởng thuế suất ưu đãi","3","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("12","3.1","Tổng thu nhập tính thuế được hưởng thuế suất ưu đãi","3","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("13","3.2","Thuế TNDN tính theo thuế suất ưu đãi","3","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("14","3.3","Thuế TNDN tính theo thuế suất phổ thông (20%)","3","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("15","3.4","Thuế TNDN chênh lệch ([4]=[3]-[2])","3","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("16","4","Xác định số thuế được miễn, giảm trong kỳ tính thuế","3","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("17","4.1","Tổng thu nhập tính thuế được miễn thuế hoặc giảm thuế","3","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("18","4.2","Thuế suất thuế TNDN ưu đãi áp dụng (%)","3","0","0","","","0");
INSERT INTO plthuetndnuudai VALUES("19","4.3","Thuế thu nhập doanh nghiệp phải nộp","3","0","0","","","0");
