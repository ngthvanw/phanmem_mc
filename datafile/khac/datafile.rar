  CONSTRAINT `fk_pskt_makh_makh` FOREIGN KEY (`makh`) REFERENCES `makh` (`makh`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;




DROP TABLE IF EXISTS psts;

CREATE TABLE `psts` (
