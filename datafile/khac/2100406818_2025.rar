  `bophan` varchar(300) NOT NULL,
  `mand` char(14) NOT NULL,
  `noidung` varchar(300) NOT NULL,
  `vondieule` bigint(20) NOT NULL,
  `vongop` bigint(20) NOT NULL,
  `tanggiam` int(1) NOT NULL,
