CREATE TABLE `sdcn` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `maso` char(3) NOT NULL,
  `maso_` char(3) DEFAULT NULL,
  `makh` char(14) DEFAULT NULL,
  `makhcha` varchar(14) NOT NULL,
  `tenkh` varchar(60) DEFAULT NULL,
