  `rank` int(10) DEFAULT NULL,
  `tennoidung_en` varchar(250) NOT NULL,
  `tennoidung_cn` varchar(250) NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `mand` (`mand`)
) ENGINE=InnoDB AUTO_INCREMENT=355 DEFAULT CHARSET=utf8;

