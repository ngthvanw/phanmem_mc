CREATE TABLE `cnkh` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `makh` varchar(14) NOT NULL,
  `tenkh` varchar(700) NOT NULL,
  `makhcha` varchar(14) NOT NULL,
