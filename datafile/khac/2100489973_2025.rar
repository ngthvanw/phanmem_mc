  `giaban` double NOT NULL,
  `giabansi` double NOT NULL,
  `giamua` double NOT NULL,
  `rate` char(2) NOT NULL,
  `mark` char(1) NOT NULL,
  `congvao` bigint(10) NOT NULL,
  `trura` bigint(10) NOT NULL,
  `dp` int(2) NOT NULL COMMENT 'chi?t kh?u t�nh %',
  `max` double NOT NULL,
