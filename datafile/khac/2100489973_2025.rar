  `niendo` char(4) NOT NULL,
  `sohuu` varchar(200) NOT NULL,
  `matkgiam` char(6) NOT NULL,
  `cpkhongduoctru` int(1) NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `mats` (`mats`)
) ENGINE=InnoDB AUTO_INCREMENT=7 DEFAULT CHARSET=utf8;

