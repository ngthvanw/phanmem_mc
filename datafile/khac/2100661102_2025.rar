  `tylekh` double NOT NULL,
  `tgsd` double(7,3) DEFAULT NULL,
  `muckhthang` bigint(13) NOT NULL,
  `muckhquy` bigint(13) NOT NULL,
  `muckhnam` bigint(13) NOT NULL,
  `matk` char(5) DEFAULT NULL,
