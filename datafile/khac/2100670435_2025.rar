UPDATE pscptt set tylekh = round(giatriconlai/muckhthang) WHERE tanggiam='0';delete from pscptt WHERE tanggiam='0' and giatriconlai='0';ALTER TABLE pskt AUTO_INCREMENT=3680;
DROP TABLE IF EXISTS psts;

CREATE TABLE `psts` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `seri` char(10) DEFAULT NULL,
  `sct` varchar(12) DEFAULT NULL,
  `ngayghiso` date NOT NULL,
  `ngaysx` date NOT NULL,
  `ngaygiam` date NOT NULL,
