DROP TABLE IF EXISTS manhom;

CREATE TABLE `manhom` (
  `sott` int(11) NOT NULL,
  `manhom` int(4) NOT NULL AUTO_INCREMENT,
  `tennhom` varchar(100) NOT NULL,
  `ghichu` text NOT NULL,
  `rank` int(11) NOT NULL,
  PRIMARY KEY (`manhom`),
  KEY `manhom` (`manhom`),
  FULLTEXT KEY `tennhom` (`tennhom`),
  FULLTEXT KEY `tennhom_2` (`tennhom`)
) ENGINE=InnoDB AUTO_INCREMENT=1231 DEFAULT CHARSET=utf8mb4;

INSERT INTO manhom VALUES('100','1100','Thành Phẩm','','0'),('99','1200','Nhóm dịch vụ','','0'),('5','1230','Hàng hóa','','53');
ALTER TABLE manhom AUTO_INCREMENT=1261;
DROP TABLE IF EXISTS manhomkh;

CREATE TABLE `manhomkh` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `manhom` int(11) NOT NULL,
  `tennhom` varchar(500) NOT NULL,
  `ghichu` text NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `u_manhom` (`manhom`)
) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8;

INSERT INTO manhomkh VALUES('1','1001','Khác',''),('10','1010','Nhân viên','');
DROP TABLE IF EXISTS masp;

CREATE TABLE `masp` (
  `sott` bigint(20) unsigned NOT NULL,
  `masp` varchar(20) NOT NULL,
  `tensp` varchar(1000) NOT NULL,
  `maspcha` varchar(20) NOT NULL,
  `dvt` varchar(100) NOT NULL,
  `ghichu` text NOT NULL,
  `tenkd` varchar(1000) DEFAULT NULL,
  `makh` varchar(14) NOT NULL,
  `diachi` varchar(300) NOT NULL,
  `namsx` date NOT NULL,
  `gthopdong` bigint(20) NOT NULL,
  `ngaykhoicong` date NOT NULL,
  `ngayhoanthanh` date NOT NULL,
  `vatlieu` bigint(20) NOT NULL,
  `nhancong` bigint(20) NOT NULL,
  `may` bigint(20) NOT NULL,
  `quyettoan` bigint(20) NOT NULL,
  `loaisp` char(2) NOT NULL,
  `chonchuyen` char(1) NOT NULL,
  `niendo` char(4) NOT NULL,
  `stt` int(11) NOT NULL AUTO_INCREMENT,
  `diabanuudai` char(10) NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `masp` (`masp`),
  UNIQUE KEY `mats` (`masp`),
  UNIQUE KEY `stt` (`stt`),
  KEY `index_maspcha` (`maspcha`),
  KEY `index_diabanuudia` (`diabanuudai`),
  FULLTEXT KEY `tenkd` (`tenkd`),
  FULLTEXT KEY `fmasp` (`masp`),
  FULLTEXT KEY `fmt` (`masp`,`tenkd`)
) ENGINE=InnoDB AUTO_INCREMENT=374 DEFAULT CHARSET=utf8;

INSERT INTO masp VALUES('127174174362181','TV-003','TƯ VẤN KHẢO SÁT, GIÁM SÁT','0','','','TU VAN KHAO SAT, GIAM SAT','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','5','0'),('127174174376345','TV-003-01','Tư vấn khảo sát và lập báo cáo kinh tế kỹ thuật công trình Đường GTNT liên ấp Rạch Gioofng - Bà Tình ( Hương lộ 30 nối với N17) (Theo HĐ số 153/2023/HĐTV ngày 06/10/2023','TV-003','','','Tu van khao sat va lap bao cao kinh te ky thuat cong trinh Duong GTNT lien ap Rach Gioofng - Ba Tinh ( Huong lo 30 noi voi N17) (Theo HD so 153/2023/HDTV ngay 06/10/2023','','','0000-00-00','263173212','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','6','DBKUD'),('127174174386934','TV-004','TƯ VẤN THẨM ĐỊNH','0','','','TU VAN THAM DINH','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','7','0'),('127174174389415','TV-004-01','Tư vấn thẩm tra thiết kế - dự toán công trình Nâng cấp, mở rộng Đường GTNT liên ấp Rạch Gốc - Bà Tình, Xã Long Hòa (cầu Xéo Đôi) (Theo HĐ số 135/2023/HĐTVTTR ngày 07/10/2023)','TV-004','','','Tu van tham tra thiet ke - du toan cong trinh Nang cap, mo rong Duong GTNT lien ap Rach Goc - Ba Tinh, Xa Long Hoa (cau Xeo Doi) (Theo HD so 135/2023/HDTVTTR ngay 07/10/2023)','','','0000-00-00','32592593','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','8','DBKUD'),('127174174468550','TV-004-03','Tư vấn thẩm định HSMT  thi công xây dựng công trình: Nâng cấp, mở rộng Trụ sở Huyện ủy và UBND huyện Càng Long (Theo HĐ số 28/2023/HĐTĐHSMT ngày 12/05/2023)','TV-004','','','Tu van tham dinh HSMT  thi cong xay dung cong trinh: Nang cap, mo rong Tru so Huyen uy va UBND huyen Cang Long (Theo HD so 28/2023/HDTDHSMT ngay 12/05/2023)','','','0000-00-00','4601419','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','10','DBKUD'),('127174174560210','TV-003-03','Tư vấn, khảo sát, lập TKBVTC dự án Đường Giao thông liên xã Mỹ Chánh - Đa Lộc, huyện Châu Thành ( Theo HĐ số 04/2024/HĐTV ngày 01/01/2024)','TV-003','','','Tu van, khao sat, lap TKBVTC du an Duong Giao thong lien xa My Chanh - Da Loc, huyen Chau Thanh ( Theo HD so 04/2024/HDTV ngay 01/01/2024)','','','0000-00-00','414642727','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','12','DBKUD'),('127174174584294','TCCT-001','Tư vấn giám sát thi công xây dựng công trình Đường kết nối Quốc lộ 53 với Đường cây ăn trái#*# Phụ lục hợp đồng số 01/PLHĐ ngày 23/3/2023 và phụ lục hợp đồng số 02/PLHĐ ngày 14/8/2023)','TV-003','','','Tu van giam sat thi cong xay dung cong trinh Duong ket noi Quoc lo 53 voi Duong cay an trai#*# Phu luc hop dong so 01/PLHD ngay 23/3/2023 va phu luc hop dong so 02/PLHD ngay 14/8/2023)','','','0000-00-00','217041819','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','14','DBKUD'),('127174174597271','TCCT-002','Tư vấn thẩm định kết quả LCNT thi công xây dựng công trình: Nâng cấp, mở rộng Trụ sở Huyện ủy và UBND huyện Càng Long (Theo HĐ số 14/2023/HĐTĐKQLCNT ngày 19/06/2023)','TV-004','','','Tu van tham dinh ket qua LCNT thi cong xay dung cong trinh: Nang cap, mo rong Tru so Huyen uy va UBND huyen Cang Long (Theo HD so 14/2023/HDTDKQLCNT ngay 19/06/2023)','','','0000-00-00','4601419','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','15','DBKUD'),('127174174670834','TV-003-04','Tư vấn lập nhiệm vụ khảo sát bước TKBVTC dự án Đường giao thông liên xã Mỹ Chánh - Đa Lộc, huyện Châu Thành (Theo HĐ số 180/2023/HĐTV ngày 36/12/2023','TV-003','','','Tu van lap nhiem vu khao sat buoc TKBVTC du an Duong giao thong lien xa My Chanh - Da Loc, huyen Chau Thanh (Theo HD so 180/2023/HDTV ngay 36/12/2023','','','0000-00-00','10069091','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','16','DBKUD'),('127174174819774','TCCT-003','Tư vấn giám sát thi công xây dựng công trình Đường kết nối Quốc lộ 53 với Đường cây ăn trái#*# Phụ lục hợp đồng số 01/PLHĐ ngày 23/03/2023 và phụ lục hợp đồng số 02/PLHĐ ngày 14/8/2023','TV-003','','','Tu van giam sat thi cong xay dung cong trinh Duon