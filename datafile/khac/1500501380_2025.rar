  FULLTEXT KEY `tenkd` (`tenkd`),
  FULLTEXT KEY `masothue` (`masothue`),
  FULLTEXT KEY `fmakh` (`makh`),
  FULLTEXT KEY `fmtm` (`makh`,`tenkd`,`masothue`),
  CONSTRAINT `fk_makh_manhom_manhom` FOREIGN KEY (`manhom`) REFERENCES `manhomkh` (`manhom`)
