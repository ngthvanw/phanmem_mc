DROP TABLE IF EXISTS plgdlk;

CREATE TABLE `plgdlk` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `maso` char(10) NOT NULL,
  `namps` int(5) NOT NULL,
