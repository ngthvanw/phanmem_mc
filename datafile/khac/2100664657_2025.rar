DROP TABLE IF EXISTS mact;

CREATE TABLE `mact` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `mact` char(14) NOT NULL,
  `tenct` varchar(200) NOT NULL,
  `mactcha` char(14) NOT NULL,
  `diachi` varchar(100) NOT NULL,
  `makh` char(10) NOT NULL,
  `so_hd` char(20) NOT NULL,
  `ngayhd` date NOT NULL,
  `ngay_kc` date NOT NULL,
  `ngay_ht` date NOT NULL,
  `giatri_hd` bigint(12) NOT NULL,
  `vatlieu` bigint(12) NOT NULL,
  `nhancong` bigint(12) NOT NULL,
  `may` bigint(12) NOT NULL,
  `tenkd` varchar(100) NOT NULL,
  PRIMARY KEY (`mact`),
  KEY `sott` (`sott`),
  KEY `tenct` (`tenct`(191)),
  KEY `mact` (`mact`),
  KEY `mactcha` (`mactcha`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

DROP TABLE IF EXISTS makh;

CREATE TABLE `makh` (
  `sott` bigint(20) unsigned NOT NULL,
  `makh` char(14) NOT NULL,
  `masothue` char(14) DEFAULT NULL,
  `tenkh` varchar(1000) DEFAULT NULL,
  `matk` char(6) DEFAULT NULL,
  `makhcha` char(14) NOT NULL,
  `sile` char(1) DEFAULT NULL,
  `diachi` varchar(1000) DEFAULT NULL,
  `dienthoai` char(20) DEFAULT NULL,
  `hanmucno` bigint(12) DEFAULT NULL,
  `noth` bigint(12) DEFAULT NULL,
  `noqh` bigint(12) DEFAULT NULL,
  `nonh` bigint(12) DEFAULT NULL,
  `nodh` bigint(12) DEFAULT NULL,
  `noxau` bigint(12) DEFAULT NULL,
  `ngaytra` date DEFAULT NULL,
  `ghichu` text,
  `tenkd` varchar(1000) DEFAULT NULL,
  `rank` bigint(20) NOT NULL DEFAULT '1',
  `loaitien` char(3) NOT NULL DEFAULT 'VND',
  `manhom` int(11) NOT NULL DEFAULT '1001',
  `niendo` char(4) NOT NULL,
  `socmnd` char(12) NOT NULL,
  `stt` int(11) NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `makh` (`makh`),
  UNIQUE KEY `stt` (`stt`),
  KEY `fk_makh_manhom_manhom` (`manhom`),
  KEY `index_makhcha` (`makhcha`),
  CONSTRAINT `fk_makh_manhom_manhom` FOREIGN KEY (`manhom`) REFERENCES `manhomkh` (`manhom`)
) ENGINE=InnoDB AUTO_INCREMENT=103 DEFAULT CHARSET=utf8;

INSERT INTO makh VALUES('173526266366','2100627239','2100627239','CÔNG TY TNHH CÂY XANH NAM ANH','','0','','Ấp Cổ Tháp B, Xã Nguyệt Hóa, Huyện Châu Thành, Tỉnh Trà Vinh, Việt Nam','','0','0','0','0','0','0','0000-00-00','','CONG TY TNHH CAY XANH NAM ANH','1','VND','1001','2024','','94'),('173526268045','2100627239-01','2100627239','2024_nhân công thi công Công trình:Nâng cấp đô thị thị trấn Vũng Liêm. Hạng mục lắp đặt đèn led trang trí, trồng dặm cây\nxanh, thảm cỏ các tuyến đường nội ô thị trấn#*# Xây dựng chỉnh trang các công viên khu vực thị trấn Vũng Liêm theo Hợp đồng số:01/HĐGK/NA-TL.VL ký ngày 05/08/2024 và biên bản nghiệm thu số 01/BBNT/NA-TL.VL','','2100627239','','Hợp đồng số:01/HĐGK/NA-TL.VL ký ngày 05/08/2024 và biên bản nghiệm thu số 01/BBNT/NA-TL.VL','','0','0','0','0','0','0','0000-00-00','','2024_nhan cong thi cong Cong trinh:Nang cap do thi thi tran Vung Liem. Hang muc lap dat den led trang tri, trong dam cay\nxanh, tham co cac tuyen duong noi o thi tran#*# Xay dung chinh trang cac cong vien khu vuc thi tran Vung Liem theo Hop dong so:01/HDGK/NA-TL.VL ky ngay 05/08/2024 va bien ban nghiem thu so 01/BBNT/NA-TL.VL','1','VND','1001','2024','','95'),('173638332361','0312318292','0312318292','CÔNG TY CỔ PHẦN XUẤT NHẬP KHẨU HÓA DẦU MIỀN NAM','','0','','71 Hàm Nghi, Phường Nguyễn Thái Bình, Quận 1, Thành phố Hồ Chí Minh, Việt Nam','','0','0','0','0','0','0','0000-00-00','','CONG TY CO PHAN XUAT NHAP KHAU HOA DAU MIEN NAM','1','VND','1001','2024','','96'),('25162675025423','0311194559','0311194559','Công Ty TNHH Đầu Tư Thương Mại Dịch Vụ Liên Thành Phát','','0','','Số 11B Đường 182, Khu Phố 3, P. Tăng Nhơn Phú A, Quận 9, TP. HCM','','0','0','0','0','0','0','0000-00-00','','Cong Ty TNHH Dau Tu Thuong Mai Dich Vu Lien Thanh Phat','1','VND','1001','2024','','1'),('25162677086544','2100108113','2100108113','Doanh Nghiệp Tư Nhân Minh Đức','','0','','29C - 29D Hùng Vương, Khóm 1, Phường 3, Thành Phố Trà Vinh, Tỉnh Trà Vinh','','0','0','0','0','0','0','0000-00-00'