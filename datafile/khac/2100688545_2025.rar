DROP TABLE IF EXISTS manhom;

CREATE TABLE `manhom` (
  `sott` int(11) NOT NULL,
  `manhom` int(4) NOT NULL AUTO_INCREMENT,
  `tennhom` varchar(100) NOT NULL,
  `ghichu` text NOT NULL,
  `rank` int(11) NOT NULL,
  PRIMARY KEY (`manhom`),
  KEY `manhom` (`manhom`),
  FULLTEXT KEY `tennhom` (`tennhom`),
  FULLTEXT KEY `tennhom_2` (`tennhom`)
) ENGINE=InnoDB AUTO_INCREMENT=1231 DEFAULT CHARSET=utf8mb4;

INSERT INTO manhom VALUES('100','1100','Thành Phẩm','','0'),('99','1200','Nhóm dịch vụ','','0'),('5','1230','Hàng hóa','','53');
ALTER TABLE manhom AUTO_INCREMENT=1261;
DROP TABLE IF EXISTS manhomkh;

CREATE TABLE `manhomkh` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `manhom` int(11) NOT NULL,
  `tennhom` varchar(500) NOT NULL,
  `ghichu` text NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `u_manhom` (`manhom`)
) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8;

INSERT INTO manhomkh VALUES('1','1001','Khác',''),('10','1010','Nhân viên','');
DROP TABLE IF EXISTS masp;

CREATE TABLE `masp` (
  `sott` bigint(20) unsigned NOT NULL,
  `masp` varchar(20) NOT NULL,
  `tensp` varchar(1000) NOT NULL,
  `maspcha` varchar(20) NOT NULL,
  `dvt` varchar(100) NOT NULL,
  `ghichu` text NOT NULL,
  `tenkd` varchar(1000) DEFAULT NULL,
  `makh` varchar(14) NOT NULL,
  `diachi` varchar(300) NOT NULL,
  `namsx` date NOT NULL,
  `gthopdong` bigint(20) NOT NULL,
  `ngaykhoicong` date NOT NULL,
  `ngayhoanthanh` date NOT NULL,
  `vatlieu` bigint(20) NOT NULL,
  `nhancong` bigint(20) NOT NULL,
  `may` bigint(20) NOT NULL,
  `quyettoan` bigint(20) NOT NULL,
  `loaisp` char(2) NOT NULL,
  `chonchuyen` char(1) NOT NULL,
  `niendo` char(4) NOT NULL,
  `stt` int(11) NOT NULL AUTO_INCREMENT,
  `diabanuudai` char(10) NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `masp` (`masp`),
  UNIQUE KEY `mats` (`masp`),
  UNIQUE KEY `stt` (`stt`),
  KEY `index_maspcha` (`maspcha`),
  KEY `index_diabanuudia` (`diabanuudai`),
  FULLTEXT KEY `tenkd` (`tenkd`),
  FULLTEXT KEY `fmasp` (`masp`),
  FULLTEXT KEY `fmt` (`masp`,`tenkd`)
) ENGINE=InnoDB AUTO_INCREMENT=261 DEFAULT CHARSET=utf8;

INSERT INTO masp VALUES('39176917813116','TV24001-079','Gói thầu số 03: Tư vấn lập hồ sơ mời thầu và đánh\ngiá hồ sơ dự thầu gói thầu xây lắp công trình Sửa\nchữa mặt đường, gia cố lề và hệ thống thoát nước\nĐường tỉnh 911B (km03+250-km04+100;\nkm05+780-km06+600), huyện Cầu Ngang','TV24001','','','Goi thau so 03: Tu van lap ho so moi thau va danh\ngia ho so du thau goi thau xay lap cong trinh Sua\nchua mat duong, gia co le va he thong thoat nuoc\nDuong tinh 911B (km03+250-km04+100;\nkm05+780-km06+600), huyen Cau Ngang','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','182','DBKK'),('39176917824751','TV24001-080','Gói thầu số 05 Tư vấn lập hồ sơ mời thầu, đánh giá\nhồ sơ dự thầu thi công xây dựng công trình Sửa\nchữa, thay thế thiết bị đóng mở cống, bọng','TV24001','','','Goi thau so 05 Tu van lap ho so moi thau, danh gia\nho so du thau thi cong xay dung cong trinh Sua\nchua, thay the thiet bi dong mo cong, bong','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','183','DBKK'),('39176917888171','TV24001-081','Gói thầu số 03: Tư vấn lập hồ sơ mời thầu và đánh\ngiá hồ sơ dự thầu gói thầu xây lắp công trình Sửa\nchữa, chống thấm mặt đường Đường tỉnh 914\n(Km04+844-Km05+944), huyện Duyên Hải','TV24001','','','Goi thau so 03: Tu van lap ho so moi thau va danh\ngia ho so du thau goi thau xay lap cong trinh Sua\nchua, chong tham mat duong Duong tinh 914\n(Km04+844-Km05+944), huyen Duyen Hai','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','184','DBKK'),('39176917908084','TV24001-082','Gói thầu số 04 Tư vấn thẩm định hồ sơ mời thầu vàthẩm định kết quả lựa chọn nhà thầu (gói thầu xâylắp) công trình Sửa chữa mặt đường và hệ thốngthoát nước Đường tỉnh 914B (Km01+890-Km03+600), huyện Cầu Ngang','TV24001','','','Goi thau so 04 Tu van tham dinh ho so moi thau vatham dinh ket qua lua chon nha thau (goi thau xaylap) cong trinh Sua chua mat duong va he thongthoat nuoc Duong tinh 914B (Km01+890-Km03+600), huyen Cau Ngang','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','185','DBKK'),('39176917935465','TV24001-083','Tư vấn lập hồ sơ mời thầu và đánh giá hồ sơ dựthầu gói thầu thi công xây dựng dự án Cải tạo vàmua sắm trang thiết bị các điểm trường trên địa bànthành phố Trà Vinh năm 2025 (theo Hợp đồng số:118/2025/HĐTV ngày 03/10/2025)','TV24001','','','Tu van lap ho so moi thau va danh gia ho so duthau goi thau thi cong xay dung du an Cai tao vamua sam trang thiet bi cac diem truong tren dia banthanh pho Tra Vinh nam 2025 (theo Hop dong so:118/2025/HDTV ngay 03/10/2025)','','','0000-00-00','18187000','0000-00-00','0000-00-00','0','0','0','0','CT','','','186','DBKK'),('39176917962388','TV24001-084','Gói thầu số 11: Tư vấn giám sát khảo sát bước thiếtkế bản vẽ thi công thuộc Dự án Dự án đầu tư xâydựng công trình Tuyến đường trục chính dọc theokênh đào Trà Vinh (đoạn từ sông Giồng Ổi đến nútN29) - Giai đoạn 1','TV24001','','','Goi thau so 11: Tu van giam sat khao sat buoc thietke ban ve thi cong thuoc Du an Du an dau tu xaydung cong trinh Tuyen duong truc chinh doc theokenh dao Tra Vinh (doan tu song Giong Oi den nutN29) - Giai doan 1','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','187','DBKK'),('39176917975157','TV24001-085','Gói thầu số 14: Tư vấn thẩm tra thiết kế bản vẽ thicông và dự toán xây dựng công trình thuộc dự ánHạ tầng Hồ chứa nước ngọt dọc bờ sông Láng Théđảm bảo an ninh nguồn nước các huyện Càng Long,Châu Thành và thành phố Trà Vinh (Hoàn thiện giaiđoạn 1 kè và vỉa hè)','TV24001','','','Goi thau so 14: Tu van tham tra thiet ke ban ve thicong va du toan xay dung cong trinh thuoc du anHa tang Ho chua nuoc ngot doc bo song Lang Thedam bao an ninh nguon nuoc cac huyen Cang Long,Chau Thanh va thanh pho Tra Vinh (Hoan thien giaidoan 1 ke va via he)','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','188','DBKK'),('39176917986054','TV24001-086','Tư khảo sát xây dựng dự án: Đầu tư đoạn đườngkết nối từ Đồng Khởi đến Sông Long Bình và trồngcây xanh tuyến đường Tuyến trung tâm chính trịhành chính tỉnh Trà Vinh','TV24001','','','Tu khao sat xay dung du an: Dau tu doan duongket noi tu Dong Khoi den Song Long Binh va trongcay xanh tuyen duong Tuyen trung tam chinh trihanh chinh tinh Tra Vinh','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','189','DBKK'),('39176917996160','TV24001-087','Tư vấn lập Báo cáo kinh tế kỹ thuật đầu tư xâydựng dự án: Đầu tư đoạn đường kết nối từ ĐồngKhởi đến Sông Long Bình và trồng cây xanh tuyếnđường Tuyến trung tâm chính trị hành chính tỉnhTrà Vinh','TV24001','','','Tu van lap Bao cao kinh te ky thuat dau tu xaydung du an: Dau tu doan duong ket noi tu DongKhoi den Song Long Binh va trong cay xanh tuyenduong Tuyen trung tam chinh tri hanh chinh tinhTra Vinh','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','190','DBKK'),('39176918006028','TV24001-088','Gói thầu số 03: Tư vấn quản lý dự án giai đoạn thựchiện dự án Cải tạo, nâng cấp Tuyến đường số 01(Đường nội bộ trong Khu công nghiệp Long Đức)thuộc dự án Cải tạo, nâng cấp Tuyến đường số 01(Đường nội bộ trong Khu công nghiệp Long Đức)','TV24001','','','Goi thau so 03: Tu van quan ly du an giai doan thuchien du an Cai tao, nang cap Tuyen duong so 01(Duong noi bo trong Khu cong nghiep Long Duc)thuoc du an Cai tao, nang cap Tuyen duong so 01(Duong noi bo trong Khu cong nghiep Long Duc)','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','191','DBKK'),('39176918028574','TV24001-089','Gói thầu số 08 Tư vấn lập nhiệm vụ, khảo sát địahình, khảo sát địa chất và thiết kế bản vẽ thi côngvà dự toán dự án: Đường trục Tây Bắc- Đông Nam','TV24001','','','Goi thau so 08 Tu van lap nhiem vu, khao sat diahinh, khao sat dia chat va thiet ke ban ve thi congva du toan du an: Duong truc Tay Bac- Dong Nam','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','192','DBKK'),('39176918042738','TV24001-090','Tư vấn khảo sát địa hình, lập TKTCDự án Nâng cấp, sửa chữa Đường tỉnh 914 (cácđoạn Km03+444 - Km04+844, Km05+944 -Km09+744 và Km24+800 - Km26+200','TV24001','','','Tu van khao sat dia hinh, lap TKTCDu an Nang cap, sua chua Duong tinh 914 (cacdoan Km03+444 - Km04+844, Km05+944 -Km09+744 va Km24+800 - Km26+200','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','193','DBKK'),('39176918050698','TV24001-091','Gói thầu số 04: Tư vấn lập HSMT, đánh giá HSDTthi công xây dựng công trình: Hệ thống thoát nướckhu dân cư ấp Bãi Vàng, xã Hưng Mỹ (theo Hợpđồng số: 27/2025/HĐTV ngày 18/3/2025; Phụ lụchợp đồng số: 01/2025/PL.HĐTV ngày 29/8/2025)','TV24001','','','Goi thau so 04: Tu van lap HSMT, danh gia HSDTthi cong xay dung cong trinh: He thong thoat nuockhu dan cu ap Bai Vang, xa Hung My (theo Hopdong so: 27/2025/HDTV ngay 18/3/2025; Phu luchop dong so: 01/2025/PL.HDTV ngay 29/8/2025)','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','194','DBKK'),('39176918093590','TV24001-092','Gói thầu số 03 Tư vấn lập hồ sơ mời thầu và đánhgiá hồ sơ dự thầu dự án Đường tỉnh 909. Hạng mục:Bảo dưỡng sửa chữa đoạn km7+113-km26+060','TV24001','','','Goi thau so 03 Tu van lap ho so moi thau va danhgia ho so du thau du an Duong tinh 909. Hang muc:Bao duong sua chua doan km7+113-km26+060','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','195','DBKK'),('39176918105711','TV24001-093','Gói thầu số 08 Tư vấn lập hồ sơ mời thầu và đánhgiá hồ sơ dự thầu dự án Sửa chữa Đường tỉnh 905đoạn Km3+597-Km4+774','TV24001','','','Goi thau so 08 Tu van lap ho so moi thau va danhgia ho so du thau du an Sua chua Duong tinh 905doan Km3+597-Km4+774','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','','196','DBKK'),('39176918113347','TV24001-094','Gói thầu số 03 Tư vấn lập hồ sơ mời thầu và đánhgiá hồ sơ dự thầu công trình Đường tỉnh 901. Hạngmục: Bảo dưỡng, sửa chữa đoạn km0+000-km23+252; km26+562-km36+775; k