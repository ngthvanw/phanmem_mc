  `matk1` char(6) NOT NULL,
  `phantramtk` int(2) NOT NULL,
  `matk2` char(6) NOT NULL,
  `loaibp` char(2) NOT NULL,
  `sapxep` int(11) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8;

