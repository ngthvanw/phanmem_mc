,'','73','DBKUD'),('127175385509531','KK-016','Thanh toán theo hợp đồng - gói thầu số 04 : Thi công xây dựng công trình sửa chữa dãy hành lang phía sau các tầng thuộc trụ sở làm việc sở xây dựng. Số : 01/2025/HĐTC Ngày 28 tháng 05 năm 2025','KK','','','Thanh toan theo hop dong - goi thau so 04 : Thi cong xay dung cong trinh sua chua day hanh lang phia sau cac tang thuoc tru so lam viec so xay dung. So : 01/2025/HDTC Ngay 28 thang 05 nam 2025','','','0000-00-00','141956481','0000-00-00','0000-00-00','0','0','0','0','CT','1','','74','DBKUD'),('127175385521056','KK-017','Thanh toán theo hợp đồng cung cấp và lắp đặt thiết bị: Gói thầu số 07 #*# Mua sắm, lắp đặt thiết bị văn phòng, sửa chữa trụ sở làm việc sở Nông Nghiệp Và Phát Triển Nông Thôn. Số : 02/2025/HĐ -TB Ngày 17 tháng 02 năm 2025.','KK','','','Thanh toan theo hop dong cung cap va lap dat thiet bi: Goi thau so 07 #*# Mua sam, lap dat thiet bi van phong, sua chua tru so lam viec so Nong Nghiep Va Phat Trien Nong Thon. So : 02/2025/HD -TB Ngay 17 thang 02 nam 2025.','','','0000-00-00','390000000','0000-00-00','0000-00-00','0','0','0','0','CT','1','','75','DBKUD');
DROP TABLE IF EXISTS matk;

CREATE TABLE `matk` (
  `sott` int(10) unsigned NOT NULL,
  `matk` char(6) NOT NULL,
  `tentk` varchar(255) DEFAULT NULL,
  `matkcha` char(4) NOT NULL,
  `loaitk` varchar(60) DEFAULT NULL,
  `mats` char(3) DEFAULT NULL,
  `mangv` char(3) DEFAULT NULL,
  `nhomtk` char(10) DEFAULT NULL,
  `shtk` int(6) NOT NULL,
  `ghichu` text,
  `ngaytao` date DEFAULT NULL,
  `rank` bigint(20) NOT NULL DEFAULT '0',
  `tentk_en` varchar(250) NOT NULL,
  `tentk_cn` varchar(250) NOT NULL,
  PRIMARY KEY (`matk`),
  KEY `rank` (`rank`)
) ENGINE=MyISAM DEFAULT CHARSET=utf8;

