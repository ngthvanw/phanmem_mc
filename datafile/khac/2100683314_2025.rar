INSERT INTO makh VALUES('209','2400010','2100672633','VĂN PHÒNG HỘI ĐỒNG NHÂN DÂN VÀ ỦY BAN NHÂN DÂN HUYỆN CẦU KÈ','','0','','Khóm 4, Thị trấn Cầu Kè, Huyện Cầu Kè, Tỉnh Trà Vinh, Việt Nam','','','','','','','','','','VAN PHONG HOI DONG NHAN DAN VA UY BAN NHAN DAN HUYEN CAU KE','1','VND','1001','2024','','209'),('210','2400010-01','','TƯ VẤN GIÁM SĂT','','2400010','','','','','','','','','','','','TU VAN GIAM SAT','1','VND','1001','2024','','210'),('211','2400010-01-001','','Xuất theo hợp đồng số: 03/2024/HĐ-GS Về việc Tư vấn giám\nsát thi công xây dựng công trình Sửa chữa nhà làm việc Hội\nđồng nhân dân và Ủy ban nhân dân huyện Cầu Kè.','','2400010-01','','hợp đồng số: 03/2024/HĐ-GS','','','','','','','','','','Xuat theo hop dong so: 03/2024/HD-GS Ve viec Tu van giam\nsat thi cong xay dung cong trinh Sua chua nha lam viec Hoi\ndong nhan dan va Uy ban nhan dan huyen Cau Ke.','1','VND','1001','2024','','211'),('212','240002-01-003','','2024_Xuất theo hợp đồng số: 08/2023/HĐ-GS Về việc Tư vấn giám\nsát thi công xây dựng công trình Khu vui chơi, giải trí dành cho\nngười già, trẻ em xã Phong Phú','','240002-01','','hợp đồng số: 08/2023/HĐ-G','','','','','','','','','','2024_Xuat theo hop dong so: 08/2023/HD-GS Ve viec Tu van giam\nsat thi cong xay dung cong trinh Khu vui choi, giai tri danh cho\nnguoi gia, tre em xa Phong Phu','1','VND','1001','2024','','212'),('213','240002-01-004','','2024_Xuất theo hợp đồng số: 11/2023/HĐ-GS Về việc Tư vấn giám\nsát thi công xây dựng công trình Trường THCS Tam Ngãi, xã\nTam Ngãi.','','240002-01','','hợp đồng số: 11/2023/HĐ-GS','','','','','','','','','','2024_Xuat theo hop dong so: 11/2023/HD-GS Ve viec Tu van giam\nsat thi cong xay dung cong trinh Truong THCS Tam Ngai, xa\nTam Ngai.','1','VND','1001','2024','','213'),('214','240002-01-005','','2024_Xuất theo hợp đồng số: 04/2024/HĐ-GS Về việc Tư vấn giám\nsát thi công lắp đặt thiết bị công trình Trường THCS Tam Ngãi,\nxã Tam Ngãi.','','240002-01','','hợp đồng số: 04/2024/HĐ-GS','','