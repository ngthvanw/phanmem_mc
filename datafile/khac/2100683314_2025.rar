DROP TABLE IF EXISTS masp;

CREATE TABLE `masp` (
  `sott` bigint(20) unsigned NOT NULL,
  `masp` varchar(20) NOT NULL,
  `tensp` varchar(1000) NOT NULL,
  `maspcha` varchar(20) NOT NULL,
  `dvt` varchar(100) NOT NULL,
  `ghichu` text NOT NULL,
  `tenkd` varchar(1000) DEFAULT NULL,
  `makh` varchar(14) NOT NULL,
  `diachi` varchar(300) NOT NULL,
  `namsx` date NOT NULL,
  `gthopdong` bigint(20) NOT NULL,
  `ngaykhoicong` date NOT NULL,
  `ngayhoanthanh` date NOT NULL,
  `vatlieu` bigint(20) NOT NULL,
  `nhancong` bigint(20) NOT NULL,
  `may` bigint(20) NOT NULL,
  `quyettoan` bigint(20) NOT NULL,
  `loaisp` char(2) NOT NULL,
  `chonchuyen` char(1) NOT NULL,
  `niendo` char(4) NOT NULL,
  `stt` int(11) NOT NULL AUTO_INCREMENT,
  `diabanuudai` char(10) NOT NULL,
  PRIMARY KEY (`sott`),
  UNIQUE KEY `masp` (`masp`),
  UNIQUE KEY `mats` (`masp`),
  UNIQUE KEY `stt` (`stt`),
  KEY `index_maspcha` (`maspcha`),
  KEY `index_diabanuudia` (`diabanuudai`),
  FULLTEXT KEY `tenkd` (`tenkd`),
  FULLTEXT KEY `fmasp` (`masp`),
  FULLTEXT KEY `fmt` (`masp`,`tenkd`)
) ENGINE=InnoDB AUTO_INCREMENT=27 DEFAULT CHARSET=utf8;

INSERT INTO masp VALUES('26','0001','Toàn Bộ','0','Cái','','Toan Bo','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','','','','26',''),('172991067033','TVGS','TƯ VẤN GIÁM SÁT','0','','','TU VAN GIAM SAT','','','0000-00-00','0','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','1','0'),('172991069422','TVGS-001','2024_Xuất theo hợp đồng số: 03/2024/HĐ-GS Về việc Tư vấn giám\nsát thi công xây dựng công trình Sửa chữa nhà làm việc Hội\nđồng nhân dân và Ủy ban nhân dân huyện Cầu Kè.','TVGS','','','2024_Xuat theo hop dong so: 03/2024/HD-GS Ve viec Tu van giam\nsat thi cong xay dung cong trinh Sua chua nha lam viec Hoi\ndong nhan dan va Uy ban nhan dan huyen Cau Ke.','','','0000-00-00','27393709','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','2','DBKK'),('172991081565','TVGS-002','2024_Xuất theo hợp đồng số: 08/2023/HĐ-GS Về việc Tư vấn giám\nsát thi công xây dựng công trình Khu vui chơi, giải trí dành cho\nngười già, trẻ em xã Phong Phú.','TVGS','','','2024_Xuat theo hop dong so: 08/2023/HD-GS Ve viec Tu van giam\nsat thi cong xay dung cong trinh Khu vui choi, giai tri danh cho\nnguoi gia, tre em xa Phong Phu.','','','0000-00-00','67318776','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','3','DBKK'),('172991103662','TVGS-003','2024_Xuất theo hợp đồng số: 04/2024/HĐ-GS Về việc Tư vấn giám\nsát thi công lắp đặt thiết bị công trình Trường THCS Tam Ngãi,\nxã Tam Ngãi.','TVGS','','','2024_Xuat theo hop dong so: 04/2024/HD-GS Ve viec Tu van giam\nsat thi cong lap dat thiet bi cong trinh Truong THCS Tam Ngai,\nxa Tam Ngai.','','','0000-00-00','2071636','0000-00-00','0000-00-00','0','0','0','0','CT','','2024','4','DBKK'),('172991117561','TVGS-004','2024_Xuất theo hợp đồng số: 11/2023/HĐ-GS Về việc Tư vấn giám\nsát thi công xây dựng công trình Trường THCS Tam Ngãi, xã\nTam Ngãi.','TVGS','','','2024_Xuat theo hop dong so: 11/2023/HD-GS Ve viec Tu van giam\nsat thi cong xay dung cong trinh Truong THCS Tam Ngai, xa\nTam Ngai.','','','0000-