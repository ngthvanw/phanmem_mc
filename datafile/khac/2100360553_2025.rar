) ENGINE=InnoDB AUTO_INCREMENT=26 DEFAULT CHARSET=latin1;

INSERT INTO plthuetndnuudai VALUES('1','1.1','Doanh nghiệp sản xuất mới thành lập từ dự án đầu tư.','1','0','0','','','0'),('2','1.2','Doanh nghiệp di chuyển địa điểm ra khỏi đô thị theo quy hoạch đã được cơ quan có thẩm quyền phê duyệt.','1','0','0','','','0'),('3','1.3','Doanh nghiệp mới thành lập từ dự án đầu tư vào ngành nghề, lĩnh vực ưu đãi đầu tư.','1','0','0','','','0'),('4','1.4','Doanh nghiệp mới thành lập từ dự án đầu tư vào ngành nghề, lĩnh vực đặc biệt ưu đãi đầu tư.','1','0','0','','','0'),('5','1.5','Doanh nghiệp mới thành lập từ dự án đầu tư vào nghành nghề, lĩnh vực ưu đãi đầu tư theo quy định tại Nghị định số 124/2008/NĐ-CP.','1','0','0','','','0'),('6','1.6','Doanh nghiệp mới thành lập từ dự án đầu tư vào địa bàn thuộc Danh mục địa bàn có điều kiện kinh tế - xã hội khó khăn.','1','0','0','','','0'),('7','1.7','Doanh nghiệp mới thành lập từ dự án đầu tư vào địa bàn thuộc Danh mục địa bàn có điều kiện kinh tế - xã hội đặc biệt khó khăn, khu kinh tế, khu công nghệ cao.','1','0','0','','','0'),('8','1.8','Doanh nghiệp thành lập mới trong lĩnh vực xã hội hoá hoặc có thu nhập từ hoạt động xã hội hoá.','1','0','0','','','0'),('9','1.9','Hợp tác xã dịch vụ nông nghiệp, Quỹ tín dụng nhân dân.','1','0','0','','','0'),('10','1.10','Ưu đãi theo Giấy phép đầu tư, Giấy chứng nhận ưu đãi đầu tư.','1','0','0','','','0'),('11','2.1','- Thuế suất thuế thu nhập doanh nghiệp ưu đãi: [PhanTram]%','2','0','17','','','0'),('12','2.2','- Thời hạn áp dụng thuế suất ưu đãi [SoNam] năm, kể từ năm [Nam]','2','0','0','1','2026','0'),('13','2.3','- Thời gian miễn thuế [SoNam] năm, kể từ năm [Nam]','2','0','0','','','0'),('14','2.4','- Thời gian giảm 50% số thuế phải nộp: [SoNam] năm, kể từ năm [Nam]','2','0','0','','','0'),('15','3','Xác định số thuế TNDN chênh lệch do doanh nghiệp hưởng thuế suất ưu đãi','3','0','0','','','0'),('16','3.1','Tổng thu nhập tính thuế được hưởng thuế suất ưu đãi','3','0','0','','','0'),('17','3.2','Thuế TNDN tính theo thuế suất ưu đãi','3','0','0','','','0'),('18','3.3','Thuế TNDN tính theo thuế suất phổ thông (20%)','3','0','0','','','0'),('19','3.4','Thuế TNDN chênh lệch ([4]=[3]-[2])','3','0','0','','','0'),('20','4','Xác định số thuế được miễn, giảm trong kỳ tính thuế','3','0','0','','','0'),('21','4.1','Tổng thu nhập tính thuế được miễn thuế hoặc giảm thuế','3','0','0','','','0'),('22','4.2','Thuế suất thuế TNDN ưu đãi áp dụng (%)','3','0','0','','','0'),('23','4.3','Thuế thu nhập doanh nghiệp phải nộp','3','0','0','','','0'),('24','4.4','Tỷ lệ thuế TNDN được miễn hoặc giảm (%)','3','0','0','','','0'),('25','4.5','Thuế TNDN được miễn, giảm','3','0','0','','','0');
