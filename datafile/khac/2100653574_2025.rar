CREATE TABLE `mavt` (
  `sott` bigint(20) unsigned NOT NULL,
  `mavt` char(20) NOT NULL,
  `tenvt` varchar(1000) DEFAULT NULL,
  `quycach` varchar(35) NOT NULL,
  `dvt` varchar(100) NOT NULL,
  `dvtp` varchar(100) NOT NULL,
