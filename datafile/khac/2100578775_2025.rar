  `dvt` varchar(50) DEFAULT NULL,
  `soluong` double NOT NULL,
  `dongia` bigint(10) NOT NULL,
  `gtvnd` bigint(14) DEFAULT NULL,
  `nguyengia` bigint(14) NOT NULL,
  `giatriconlai` bigint(14) NOT NULL,
