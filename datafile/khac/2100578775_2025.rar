  `dn_baohiemyt` bigint(20) NOT NULL,
  `dn_baohiemtn` bigint(20) NOT NULL,
  `tienangiuaca` bigint(20) NOT NULL,
  `phucapkhongdungbhxh` bigint(20) NOT NULL,
