  `matk` varchar(100) NOT NULL,
  `tkno` varchar(100) NOT NULL,
  `sotiendk` bigint(20) NOT NULL,
  `ghichu` text NOT NULL,
  PRIMARY KEY (`sott`)
) ENGINE=InnoDB AUTO_INCREMENT=373 DEFAULT CHARSET=utf8;

