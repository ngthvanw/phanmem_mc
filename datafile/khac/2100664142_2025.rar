CREATE TABLE `tokhaitndn` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `maso` varchar(5) NOT NULL,
  `chitieu` varchar(500) NOT NULL,
  `machitieu` varchar(5) NOT NULL,
