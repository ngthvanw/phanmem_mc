) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4;




DROP TABLE IF EXISTS saoluu_phuchoi;

CREATE TABLE `saoluu_phuchoi` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
