  `stt` int(11) NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`mavt`),
  UNIQUE KEY `umavt` (`mavt`),
  UNIQUE KEY `stt` (`stt`),
  KEY `sott` (`sott`),
  KEY `mavt` (`mavt`),
