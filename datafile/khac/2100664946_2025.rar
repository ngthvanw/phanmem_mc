INSERT INTO masp VALUES('173744904422','23003-037','Thẩm tra thiết kế bản vẽ thi công và dự toán, dự án Sửa chữa hệ thống đèn chiếu sáng công cộng, cổng đèn hoa, cổng văn hóa, cổng chào, trên địa bàn thị trấn Châu Thành (Hợp đồng số 14/2024/HĐTTr ngày 26/6/2024)','23003','','','Tham tra thiet ke ban ve thi cong va du toan, du an Sua chua he thong den chieu sang cong cong, cong den hoa, cong van hoa, cong chao, tren dia ban thi tran Chau Thanh (Hop dong so 14/2024/HDTTr ngay 26/6/2024)','','.','0000-00-00','5354000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','41','DBKK'),('173744927064','23003-038','Hợp đồng tư vấn số 26/2024/HĐTV ngày 19/8/2024 về việc khảo sát định vị tuyến đường dây 110kV Trà Vinh - Long Đức (Đoạn qua khu đất của Công ty Cổ phần Tập Đoàn Trường Hải)','23003','','','Hop dong tu van so 26/2024/HDTV ngay 19/8/2024 ve viec khao sat dinh vi tuyen duong day 110kV Tra Vinh - Long Duc (Doan qua khu dat cua Cong ty Co phan Tap Doan Truong Hai)','','.','0000-00-00','79920000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','42','DBKK'),('173744939595','23003-039','Chi phí vệ sinh bảo trì trạm biến áp, chi phí thí nghiệm định kỳ vật tư thiết bị trạm biến áp (Hợp đồng giao khoán nhân công số 21/2024/HĐXL ngày 17/7/2024)','23003','','','Chi phi ve sinh bao tri tram bien ap, chi phi thi nghiem dinh ky vat tu thiet bi tram bien ap (Hop dong giao khoan nhan cong so 21/2024/HDXL ngay 17/7/2024)','','.','0000-00-00','16794000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','43','DBKK'),('173744954484','23003-040','Tư vấn giám sát thi công xây dựng Gói thầu số 28 - Tư vấn giám sát thi công xây dựng di dời điện trung thế, hạ thế#*# di dời hoàn trả đường ống cấp nước (Hợp đồng số 54/2023/HĐXD ngày 20/4/2023)','23003','','','Tu van giam sat thi cong xay dung Goi thau so 28 - Tu van giam sat thi cong xay dung di doi dien trung the, ha the#*# di doi hoan tra duong ong cap nuoc (Hop dong so 54/2023/HDXD ngay 20/4/2023)','','.','0000-00-00','42397000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','44','DBKK'),('173744968229','23003-041','Thay mới đường dây điện hạ thế - Trường cao đẳng nghề Trà Vinh (Hợp đồng số 02/2024/HĐTC ngày 24/10/2024)','23003','','','Thay moi duong day dien ha the - Truong cao dang nghe Tra Vinh (Hop dong so 02/2024/HDTC ngay 24/10/2024)','','.','0000-00-00','16418592','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','45','DBKK'),('173744988526','23003-042','Gói thầu tư vấn thẩm tra thiết kế bản vẽ thi công và dự toán, công trình Hệ thống chiếu sáng đường GTNT ấp Thông Thảo, xã Hòa Ân (từ Quốc lộ 54 đến Nhà trọ Thanh Tâm) (Hợp đồng số 17/2024/HĐTTr ngày 20/9/2024)','23003','','','Goi thau tu van tham tra thiet ke ban ve thi cong va du toan, cong trinh He thong chieu sang duong GTNT ap Thong Thao, xa Hoa An (tu Quoc lo 54 den Nha tro Thanh Tam) (Hop dong so 17/2024/HDTTr ngay 20/9/2024)','','.','0000-00-00','4320000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','46','DBKK'),('173745172723','23003-043','Gói thầu tư vấn thẩm tra thiết kế bản vẽ thi công và dự toán, công trình Hệ thống chiếu sáng đường GTNT ấp Trà Ốt, xã Thông Hòa (Điểm đầu cầu Lục Lạc#*# điểm cuối nhà chú Hiền) (Hợp đồng số 15/2024/HĐTTr ngày 26/7/2024)','23003','','','Goi thau tu van tham tra thiet ke ban ve thi cong va du toan, cong trinh He thong chieu sang duong GTNT ap Tra Ot, xa Thong Hoa (Diem dau cau Luc Lac#*# diem cuoi nha chu Hien) (Hop dong so 15/2024/HDTTr ngay 26/7/2024)','','.','0000-00-00','4320000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','47','DBKK'),('173745189472','23003-044','Chi phí lắp tụ bù hạ thế, thí nghiệm và vệ sinh bảo trì định kỳ trạm biến áp (Hợp đồng số 44/2024/HĐTC ngày 20/10/2024)','23003','','','Chi phi lap tu bu ha the, thi nghiem va ve sinh bao tri dinh ky tram bien ap (Hop dong so 44/2024/HDTC ngay 20/10/2024)','','.','0000-00-00','25434000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','48','DBKK'),('173745202591','23003-045','Tư vấn giám sát gói thầu số 42: Tư vấn giám sát thi công di dời lưới điện và đường ống cấp nước sinh hoạt (huyện Càng Long), dự án Hạ tầng Hồ chứa nước ngọt dọc bờ sông Láng Thé đảm bảo an ninh nguồn nước các huyện Càng Long, Châu Thành và thành phố Trà Vinh (giai đoạn 1) (Hợp đồng số 35/2024/HĐ-TVXD ngày 12/8/2024)','23003','','','Tu van giam sat goi thau so 42: Tu van giam sat thi cong di doi luoi dien va duong ong cap nuoc sinh hoat (huyen Cang Long), du an Ha tang Ho chua nuoc ngot doc bo song Lang The dam bao an ninh nguon nuoc cac huyen Cang Long, Chau Thanh va thanh pho Tra V','','.','0000-00-00','9360000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','49','DBKK'),('173745209959','23003-046','Tư vấn giám sát gói thầu số 41: Tư vấn giám sát thi công di dời lưới điện và đường ống cấp nước sinh hoạt (huyện Châu Thành), dự án Hạ tầng Hồ chứa nước ngọt dọc bờ sông Láng Thé đảm bảo an ninh nguồn nước các huyện Càng Long, Châu Thành và thành phố Trà Vinh (giai đoạn 1) (Hợp đồng số 37/2024/HĐ-TVXD ngày 20/8/2024)','23003','','','Tu van giam sat goi thau so 41: Tu van giam sat thi cong di doi luoi dien va duong ong cap nuoc sinh hoat (huyen Chau Thanh), du an Ha tang Ho chua nuoc ngot doc bo song Lang The dam bao an ninh nguon nuoc cac huyen Cang Long, Chau Thanh va thanh pho Tra','','.','0000-00-00','71526000','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','50','DBKK'),('173745224548','23003-047','Gói thầu số 13 – Tư vấn khảo sát, lập thiết kế BVTC hạng mục di dời lưới điện, dự án Cải tạo, nâng cấp Đường huyện 15 (đoạn từ cầu Đa Hòa 1 đến Bãi Vàng), huyện Châu Thành (Hợp đồng số 20/2024/HĐTV ngày 28/02/2024)','23003','','','Goi thau so 13 – Tu van khao sat, lap thiet ke BVTC hang muc di doi luoi dien, du an Cai tao, nang cap Duong huyen 15 (doan tu cau Da Hoa 1 den Bai Vang), huyen Chau Thanh (Hop dong so 20/2024/HDTV ngay 28/02/2024)','','.','0000-00-00','43829267','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','51','DBKK'),('173745255731','23003-048','Gói thầu số 08: Giám sát thi công di dời hệ thống điện nằm trong phạm vi GPMB khu vực huyện Tiểu Cần, Tiểu dự án đầu tư xây dựng cầu Đại Ngãi trên Quốc lộ 60 thuộc địa phận các tỉnh Trà Vinh và Sóc Trăng (đoạn trên địa bàn tỉnh Trà Vinh), hạng mục: Di dời hệ thống điện và nước nằm trong phạm vi GPMB khu vực huyện Tiểu Cần (Hợp đồng số 51/HĐXD ngày 29 /11/2023#*# Phụ lục số 01/PLHĐ ngày 04/3/2024#*# Phụ lục số 02/PLHĐ ngày 30/9/2024)','23003','','','Goi thau so 08: Giam sat thi cong di doi he thong dien nam trong pham vi GPMB khu vuc huyen Tieu Can, Tieu du an dau tu xay dung cau Dai Ngai tren Quoc lo 60 thuoc dia phan cac tinh Tra Vinh va Soc Trang (doan tren dia ban tinh Tra Vinh), hang muc: Di doi','','.','0000-00-00','47102727','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','52','DBKK'),('173745267481','23003-049','Gói thầu: “Khảo sát, lập Báo cáo kinh tế kỹ thuật” thuộc công trình “Đầu tư điện AC cho các trạm vô tuyến di động giai đoạn 2023-2024 – VNPT Trà Vinh năm 2024” (Hợp đồng số 009-2024/VNPT TVH-CTY HOAQUANG/HĐTV ngày 20/5/2024)','23003','','','Goi thau: “Khao sat, lap Bao cao kinh te ky thuat” thuoc cong trinh “Dau tu dien AC cho cac tram vo tuyen di dong giai doan 2023-2024 – VNPT Tra Vinh nam 2024” (Hop dong so 009-2024/VNPT TVH-CTY HOAQUANG/HDTV ngay 20/5/2024)','','.','0000-00-00','40384179','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','53','DBKK'),('173745306014','23003-050','Chi phí vệ sinh bảo trì và thí nghiệm định kỳ trạm biến áp (Hợp đồng số 46/2024/HĐTC ngày 20/10/2024)','23003','','','Chi phi ve sinh bao tri va thi nghiem dinh ky tram bien ap (Hop dong so 46/2024/HDTC ngay 20/10/2024)','','.','0000-00-00','29926800','0000-00-00','0000-00-00','0','0','0','0','CT','1','2024','54','DBKK'),('173745319491','23003-051','Gói số 01- Thi công nâng cấp phát triển lưới điện khu vực thành phố Trà Vinh năm 2024, công trình:Nâng cấp phát triển lưới điện khu vực thành phố Trà Vinh năm 2024 (Theo h