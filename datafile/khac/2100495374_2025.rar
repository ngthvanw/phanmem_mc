  `nock` bigint(20) NOT NULL,
  `cock` bigint(20) NOT NULL,
  `cap` int(10) NOT NULL,
  `_nock` bigint(20) NOT NULL,
  `_cock` bigint(20) NOT NULL,
  `matkcha` varchar(6) NOT NULL,
  PRIMARY KEY (`sott`)
) ENGINE=InnoDB AUTO_INCREMENT=57 DEFAULT CHARSET=utf8;

