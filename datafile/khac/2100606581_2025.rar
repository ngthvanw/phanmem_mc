  `tenvt` varchar(1000) DEFAULT NULL,
  `matk` char(5) DEFAULT NULL,
  `quycach` varchar(35) DEFAULT NULL,
  `manhom` char(6) NOT NULL,
  `tennhom` varchar(100) NOT NULL,
  `dvt` varchar(50) DEFAULT NULL,
  `dvtp` varchar(5) DEFAULT NULL,
