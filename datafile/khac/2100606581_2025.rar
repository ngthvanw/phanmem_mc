  CONSTRAINT `fk_tk_mavt_mavt` FOREIGN KEY (`mavt`) REFERENCES `mavt` (`mavt`),
  CONSTRAINT `tk_ibfk_70` FOREIGN KEY (`mavt`) REFERENCES `mavt` (`mavt`),
  CONSTRAINT `tk_ibfk_71` FOREIGN KEY (`mavt`) REFERENCES `mavt` (`mavt`),
  CONSTRAINT `tk_ibfk_72` FOREIGN KEY (`mavt`) REFERENCES `mavt` (`mavt`),
  CONSTRAINT `tk_ibfk_73` FOREIGN KEY (`mavt`) REFERENCES `mavt` (`mavt`),
  CONSTRAINT `tk_ibfk_74` FOREIGN KEY (`mavt`) REFERENCES `mavt` (`mavt`)
) ENGINE=InnoDB AUTO_INCREMENT=19 DEFAULT CHARSET=utf8;

