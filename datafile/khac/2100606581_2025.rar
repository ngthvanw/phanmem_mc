DROP TABLE IF EXISTS plthuetndnuudai;

CREATE TABLE `plthuetndnuudai` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `machitieu` char(5) NOT NULL,
  `chitieu` varchar(500) NOT NULL,
  `machitieucha` char(5) NOT NULL,
