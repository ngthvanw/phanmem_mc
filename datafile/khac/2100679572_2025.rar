  `niendo` char(4) NOT NULL,
  `cpkhongduoctru` int(1) NOT NULL,
  `theodoi` int(1) NOT NULL DEFAULT '1',
  PRIMARY KEY (`sott`),
  UNIQUE KEY `mats` (`mats`)
) ENGINE=InnoDB AUTO_INCREMENT=8 DEFAULT CHARSET=utf8;

