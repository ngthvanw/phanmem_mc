  `muckhquy` double DEFAULT NULL,
  `muckhnam` double NOT NULL,
  `tkco` char(6) NOT NULL,
  `tkno` char(6) NOT NULL,
  `chuthich` text,
  `mabp` char(6) NOT NULL,
  `bophan` varchar(200) NOT NULL,
  `manhomts` char(6) NOT NULL,
  `tenkd` varchar(200) NOT NULL,
