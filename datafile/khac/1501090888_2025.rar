DROP TABLE IF EXISTS thongtinchung;

CREATE TABLE `thongtinchung` (
  `sott` int(11) NOT NULL AUTO_INCREMENT,
  `noidung` text NOT NULL,
  `ghichu` text NOT NULL,
  PRIMARY KEY (`sott`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8;

