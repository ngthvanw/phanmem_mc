  `tuso` varchar(11) NOT NULL,
  `denso` int(11) NOT NULL,
  `ngaynhap` date NOT NULL,
  `gionhap` time NOT NULL,
  `loaiphieu` int(11) NOT NULL,
  `nguoinhap` varchar(20) NOT NULL,
  `gt1` bigint(20) NOT NULL,
  `gt2` bigint(20) NOT NULL,
